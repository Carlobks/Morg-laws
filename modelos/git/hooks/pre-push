#!/bin/sh
# Portão do git (Morg-laws): verifica antes de o código sair da máquina. Nunca saltar com --no-verify.
# Mostra os arquivos dos commits a enviar, procura segredos com o gitleaks e falhas novas nas dependências com o
# npm audit. Lógica: scripts/portoes/antes_do_push.py. Precisa do gitleaks.
# Alternativa só em sh, sem Python: modelos/pre-push do Morg-laws.
raiz=$(git rev-parse --show-toplevel) || exit 1
py=${MORG_PY:-$(command -v py || command -v python3)}
exec "$py" -I "$raiz/scripts/portoes/antes_do_push.py"
