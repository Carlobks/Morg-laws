#!/bin/sh
# Portão do git (Morg-laws): a mensagem do commit segue o formato e é tão pública quanto o código.
# Formato: início de scripts/portoes/mensagem_commit.py. Instalar como o pre-commit ao lado.
raiz=$(git rev-parse --show-toplevel) || exit 1
py=${MORG_PY:-$(command -v py || command -v python3)}
portoes="$raiz/scripts/portoes"

"$py" -I "$portoes/mensagem_commit.py" "$1" || exit 1
grep -v '^#' "$1" | "$py" -I "$portoes/lista_negra.py" "a mensagem do commit"
