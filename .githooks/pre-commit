#!/bin/sh
# Portão do Morg-laws: nada sensível entra no repositório público.
dir=$(dirname "$0")

# 1. A identidade do commit tem de ser o e-mail noreply do GitHub.
email=$(git config user.email)
case "$email" in
  *@users.noreply.github.com) ;;
  *)
    echo "ERRO: user.email é '$email'. Use o e-mail noreply do GitHub:" >&2
    echo "  git config --local user.email <id>+<usuario>@users.noreply.github.com" >&2
    exit 1 ;;
esac

# 1b. O nome do autor também fica público em cada commit: passa pela lista negra.
git config user.name | sh "$dir/verificar-lista-negra.sh" "nome do autor (user.name)" || exit 1

# 2. Linhas adicionadas e nomes dos arquivos não podem casar com a lista negra.
{
  git diff --cached --name-only --diff-filter=ACMR
  git diff --cached -U0 --diff-filter=ACMR | grep '^+' | grep -v '^+++'
} | sh "$dir/verificar-lista-negra.sh" "arquivos preparados" || exit 1

# 2b. Em todos os commits: nada que identifique pessoas ou empresas entra em projetos/ (o catálogo publicado).
# O teste lê o que está preparado (git add), não o disco. Sem Python o commit não passa (falha fechada).
py=${MORG_PY:-$(command -v py || command -v python3)}
if [ -z "$py" ] || ! "$py" -c '' 2>/dev/null; then
  echo "ERRO: sem Python não há como conferir projetos/ (defina MORG_PY ou ponha py/python3 no PATH)." >&2
  exit 1
fi
if [ ! -f tests/test_projetos_sem_dados.py ]; then  # sem o arquivo o unittest acha 0 testes e, em alguns Python, sai com 0
  echo "ERRO: falta tests/test_projetos_sem_dados.py: sem ele não há como conferir projetos/." >&2
  exit 1
fi
MORG_LER_DO_INDICE=1 "$py" -X utf8 -m unittest discover -s tests -p test_projetos_sem_dados.py || {
  echo "ERRO: dado pessoal ou identificador em projetos/ (o teste acima diz onde). Troque pelo papel e tente de novo." >&2
  exit 1; }

# 3. AGENTS.md é lido inteiro em todo turno: no máximo 60 linhas.
if [ -f AGENTS.md ]; then
  linhas=$(wc -l < AGENTS.md)
  if [ "$linhas" -gt 60 ]; then
    echo "ERRO: AGENTS.md tem $linhas linhas (máximo 60). Mova o detalhe para uma skill." >&2
    exit 1
  fi
fi
exit 0
